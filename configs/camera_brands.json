{
  "tapo":      { "label": "TP-Link Tapo", "port": 554, "onvif_port": 2020,
                 "main": "rtsp://{user}:{password}@{host}:{port}/stream1",
                 "sub":  "rtsp://{user}:{password}@{host}:{port}/stream2" },
  "hikvision": { "label": "Hikvision", "port": 554, "onvif_port": 80,
                 "channels": true,
                 "main": "rtsp://{user}:{password}@{host}:{port}/Streaming/Channels/{channel}01",
                 "sub":  "rtsp://{user}:{password}@{host}:{port}/Streaming/Channels/{channel}02" },
  "dahua":     { "label": "Dahua / Imou", "port": 554, "onvif_port": 80,
                 "channels": true,
                 "main": "rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype=0",
                 "sub":  "rtsp://{user}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype=1" },
  "xmeye":     { "label": "XMEye / iCSee", "port": 554, "onvif_port": 8899,
                 "channels": true,
                 "main": "rtsp://{host}:{port}/user={user}&password={password}&channel={channel}&stream=0.sdp",
                 "sub":  "rtsp://{host}:{port}/user={user}&password={password}&channel={channel}&stream=1.sdp" },
  "vivotek":   { "label": "Vivotek", "port": 554, "onvif_port": 80,
                 "main": "rtsp://{user}:{password}@{host}:{port}/live1.sdp",
                 "sub":  "rtsp://{user}:{password}@{host}:{port}/live2.sdp" },
  "custom":    { "label": "URL manual", "main": "{url}", "sub": "{url}" }
}
